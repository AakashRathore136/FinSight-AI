    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^7.2.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^2.11.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
