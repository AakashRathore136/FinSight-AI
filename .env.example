# HUGGINGFACE_API_KEY: Required for Hugging Face Inference API calls.
# Get your API key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_your_api_key_here"

# Firebase client SDK config (used by Vite frontend)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Firebase server config
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# FIREBASE_SERVICE_ACCOUNT: Optional for local development.
# If omitted, the server will try Google Application Default Credentials.
# Set this to the full Firebase service account JSON for production/Admin SDK access.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
